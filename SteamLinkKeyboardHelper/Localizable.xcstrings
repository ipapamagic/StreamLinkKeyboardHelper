      "comment" : "Menu status line when Steam Link is foreground",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link: foreground"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link: フォアグラウンド"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link:前景執行中"
          }
        }
      }
    },
    "notification.accessibilityNeeded.body" : {
      "comment" : "Notification body when Accessibility permission is missing",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Steam Link Keyboard Helper in System Settings > Privacy & Security > Accessibility to block F4 directly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定 > プライバシーとセキュリティ > アクセシビリティ」で Steam Link Keyboard Helper を許可すると、F4 を直接ブロックできます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請到「系統設定 > 隱私權與安全性 > 輔助使用」允許 Steam Link Keyboard Helper,才能直接封鎖 F4。"
          }
        }
      }
    },
    "notification.accessibilityNeeded.title" : {
      "comment" : "Notification title when Accessibility permission is missing",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility permission needed"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティの許可が必要です"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要輔助使用權限"
          }
        }
      }
    },
    "notification.foreground.body" : {
      "comment" : "Notification body when Steam Link becomes foreground",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F4 Spotlight disabled. Input source switched to ABC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F4 Spotlight を無効にしました。入力ソースを ABC に切り替えました。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F4 Spotlight 已停用,輸入法已切換到 ABC。"
          }
        }
      }
    },
    "notification.foreground.title" : {
      "comment" : "Notification title when Steam Link becomes foreground",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link foreground"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link がフォアグラウンド"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link 前景執行"
          }
        }
      }
    },
