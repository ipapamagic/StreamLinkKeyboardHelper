    "notification.running.body" : {
      "comment" : "Notification body shown right after the app launches",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for F4 in the menu bar. Steam Link foreground will switch to ABC and block F4."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの F4 を確認してください。Steam Link がフォアグラウンドになると ABC に切り替え、F4 をブロックします。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列尋找 F4 圖示。Steam Link 前景執行時會自動切換到 ABC 輸入法並封鎖 F4。"
          }
        }
      }
    },
