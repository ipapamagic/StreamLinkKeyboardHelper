      "comment" : "Notification body when Steam Link leaves foreground",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F4 Spotlight restored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
