          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F4 Spotlight 已還原。"
          }
        }
      }
    },
    "notification.leftForeground.title" : {
      "comment" : "Notification title when Steam Link leaves foreground",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Link left foreground"
